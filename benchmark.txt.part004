        w.writeStartElement(tag);
        if (obj.getPlcAndNm() != null) writeLeaf(w, "PlcAndNm", obj.getPlcAndNm());
        if (obj.getTxId() != null) writeLeaf(w, "TxId", obj.getTxId());
        if (obj.getTxSeqNb() != null) writeLeaf(w, "TxSeqNb", obj.getTxSeqNb());
        if (obj.getTxIdDt() != null) writeLeaf(w, "TxIdDt", obj.getTxIdDt().toXMLFormat());
        if (obj.getTxIdQty() != null) write_FinancialInstrumentQuantity15Choice(w, "TxIdQty", obj.getTxIdQty());
        if (obj.getEntitldAmt() != null) write_RestrictedFINActiveCurrencyAndAmount(w, "EntitldAmt", obj.getEntitldAmt());
        if (obj.getEntitldQty() != null) write_FinancialInstrumentQuantity15Choice(w, "EntitldQty", obj.getEntitldQty());
        if (obj.getAgtNtrdQty() != null) write_FinancialInstrumentQuantity15Choice(w, "AgtNtrdQty", obj.getAgtNtrdQty());
        if (obj.getAgtRmngQty() != null) write_FinancialInstrumentQuantity15Choice(w, "AgtRmngQty", obj.getAgtRmngQty());
        if (obj.getCstmrRefId() != null) writeLeaf(w, "CstmrRefId", obj.getCstmrRefId());
        w.writeEndElement();
    }

    private static void writeLeaf(XMLStreamWriter w, String tag, String text) throws XMLStreamException {
        w.writeStartElement(tag);
        w.writeCharacters(text);
        w.writeEndElement();
    }
}

