                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TJXU">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ManualUserTax</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Manual user tax adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="MISC">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">MiscellaneousSettlement</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Miscellaneous (adjustment) transaction.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="OTHR">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">Other</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Reserved for new user defined reason codes.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TJXD">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ReclassificationTaxWithholding</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Reclassification tax withholding related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRD1">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ReorganisationDepositPhaseOne</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Participant deposited a security within 10 days after a corporate action event has occurred.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRD2">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ReorganisationDepositPhaseTwo</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Participant deposited a security 10 days after a corporate action event has occurred.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="REVA">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">Reversal</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Reversal related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TJXR">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ReversalOfTaxWithholding</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Reversal of tax withholding related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TJXV">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">IntraDayReversalOfOriginalTaxWithholding</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Intra-day reversal of original tax withholding related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRML">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">LegalReorganisationDeposits</xs:documentation>
