            switch (r.getLocalName()) {
                case "Pgntn": obj.setPgntn(read_Pagination1(r)); break;
                case "MvmntConfId": obj.setMvmntConfId(r.getElementText()); break;
                case "MvmntPrlimryAdvcId": obj.setMvmntPrlimryAdvcId(read_DocumentIdentification311(r)); break;
                case "CorpActnGnlInf": obj.setCorpActnGnlInf(read_CorporateActionGeneralInformation1791(r)); break;
                case "AcctDtls": obj.setAcctDtls(read_AccountAndBalance581(r)); break;
                case "CorpActnDtls": obj.setCorpActnDtls(read_CorporateAction851(r)); break;
