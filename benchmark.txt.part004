    private static void write_CorporateActionMovementCashMovementDetailsSD5(XMLStreamWriter w, String tag, CorporateActionMovementCashMovementDetailsSD5 obj) throws XMLStreamException {
        w.writeStartElement(tag);
        if (obj.getPlcAndNm() != null) writeLeaf(w, "PlcAndNm", obj.getPlcAndNm());
