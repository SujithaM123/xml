<xs:schema xmlns="urn:iso:std:iso:20022:tech:xsd:supl.009.001.11" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="urn:iso:std:iso:20022:tech:xsd:supl.009.001.11">
    <xs:element name="Document" type="Document"/>
    <xs:simpleType name="ActiveCurrencyCode">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">ActiveCurrencyCode</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">A code allocated to a currency by a Maintenance Agency under an international identification scheme as described in the latest edition of the international standard ISO 4217 "Codes for the representation of currencies and funds".</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3,3}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="CorporateActionBalanceSD4">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">CorporateActionBalanceSD4</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Provides additional information regarding corporate action balance details.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="0" name="PlcAndNm" type="Max350Text">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">PlaceAndName</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Xpath to the element that is being extended.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="OrgnlBal" type="SignedQuantityFormat9">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">OriginalBalance</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Position held in a security as of the day prior to publication date. This position is subject to a redemption lottery call when this is the first lottery. This balance will not be adjusted for the supplemental or concurrent lotteries and will remain constant to report the original position.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="AdjstdBal" type="SignedQuantityFormat9">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">AdjustedBalance</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjusted position held in a security that is subject to redemption call.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="UpldgdBal" type="SignedQuantityFormat9">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">UnpledgedBalance</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Portion of the original balance position held in DTC general free account as of day prior to publication date. Position held in this account is subject to redemption lottery call.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="InvstmtUpldgdBal" type="SignedQuantityFormat9">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">InvestmentUnpledgedBalance</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Portion of the original balance position held in DTC segregated account as of day prior to publication date. Position held in this account is subject to redemption lottery call and must be released to allow allocation.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="InvstmtPldgdBal" type="SignedQuantityFormat9">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">InvestmentPledgedBalance</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Portion of the original balance position held in DTC investment account as of day prior to publication date. Position held in this account is subject to redemption lottery call and must be released to allow allocation.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="MemoSgrtnBal" type="SignedQuantityFormat9">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">MemoSegregationBalance</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Position held in DTC segregated account. This position is eligible for payment.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CorporateActionGeneralInformationSD58">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">CorporateActionGeneralInformationSD58</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Provides additional information regarding corporate action general information details.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="0" name="PlcAndNm" type="Max350Text">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">PlaceAndName</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Xpath to the element that is being extended.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="EvtGrp" type="EventGroup1Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">EventGroup</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">DTC processing domain/ category for event types.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="EvtTp" type="ExtendedEventType6Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">EventType</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">DTCC (The Depository Trust and Clearing Corporation) native corporate action event type name. Used in place for the events that cannot be classified by ISO code and mapped to OTHR or when two or more distinct events (in DTCC model) use same ISO code and there are no additional data elements that distinguish those two or more events.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="SubEvtTp" type="DTCCSubEventType11Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">SubEventType</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">DTCC (The Depository Trust and Clearing Corporation) native corporate action sub event type name further defines the event type.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="RedId" type="Max10NumericText">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RedemptionIdentification</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Unique number systemically assigned to all lottery and non-lottery events announced in DTC redemptions (REDS) participant terminal system (PTS) / participant browser system (PBS) function.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CorporateActionMovementCashMovementDetailsSD5">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">CorporateActionMovementCashMovementDetailsSD5</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Provides additional information regarding corporate action movement details.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="0" name="PlcAndNm" type="Max350Text">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">PlaceAndName</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Xpath to the element that is being extended.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="CdtDbtInd" type="CreditDebitCode">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">CreditDebitIndicator</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Indicates whether the value is a debit or a credit.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="PyoutTp" type="DTCCPayoutType5Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">PayoutType</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Specifies the type of payout associated with the event (for example: principal, long term capital gain).</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="TxAmt" type="RestrictedFINActiveCurrencyAndAmount">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">TransactionAmount</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Resulting cash amount concerned in this transaction.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="RsnCd" type="DTCAdjustmentPaymentType4Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ReasonCode</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Transaction reason.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="SubRsnCd" type="DTCAdjustmentPaymentSubReason2Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">SubReasonCode</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Transaction sub reason.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="ContraPtcptNb" type="Max8Text">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ContraParticipantNumber</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Transaction contra participant identification when shares are distributed / delivered to / from another participant.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="EarlstPmtDt" type="DateFormat48Choice">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">EarliestPaymentDate</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Date/Time on which the posting / draft of cash is scheduled to take place for a transaction.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="RDPRefNb" type="Exact32AlphaNumericText">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RDPReferenceNumber</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Unique DTCC legacy reference used for matching and reconciling legacy CCF records. The element will be populated to all levels of the message (event details, options, movements) where applicable to indicate how values are sourced from CCF legacy files. For example: event has 2 related activity types 74, and 54. If event details and cash option are sourced from the activity type 74, then activity type 74 will be in RDP reference number in event details, and also on the cash option. The activity type 54 will be "on" the security option. Also, usage rules will specify the different layouts of the RDP reference number based on DTCC event group (reorganization, distribution, or redemption).</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="TaxAdjstmntRate" type="PercentageRate">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">TaxAdjustmentRate</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Set of the DTC legacy sub reason codes representing tax rate. Used with reason codes ‘TJXD’ ‘TJXF’ ‘TJXI’ ‘TJXL’ ‘TJXR’ ‘TJXT’ ‘TJXU’ to identify the correct tax rate.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="TxQty" type="FinancialInstrumentQuantity15Choice">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">TransactionQuantity</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Quantity used on adjustment transactions which when summed across all extension movements equals the relevant balance in the core message. For example, a summation of loan and borrow movements when summed which is negative will show the net total in the borrow balance in the core message. While a summation of loan and borrow movements which is positive will show in the loan balance.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CorporateActionMovementSecuritiesMovementDetailsSD5">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">CorporateActionMovementSecuritiesMovementDetailsSD5</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Provides additional information regarding corporate action movement securities movement rate details.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="0" name="PlcAndNm" type="Max350Text">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">PlaceAndName</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Xpath to the element that is being extended.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="CdtDbtInd" type="CreditDebitCode">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">CreditDebitIndicator</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Indicates whether the value is a debit or a credit.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="PyoutTp" type="DTCCPayoutType4Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">PayoutType</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Specifies the type of payout associated with the event (for example: principal, long term capital gain).</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="TxQty" type="FinancialInstrumentQuantity15Choice">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">TransactionQuantity</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Resulting quantity of securities concerned in this transaction.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="RsnCd" type="DTCAdjustmentPaymentType4Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ReasonCode</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Transaction reason.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="SubRsnCd" type="DTCAdjustmentPaymentSubReason2Code">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">SubReasonCode</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Transaction sub reason.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="ContraPtcptNb" type="Max8Text">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ContraParticipantNumber</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Transaction contra participant identification when shares are distributed / delivered to / from another participant.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="EarlstPmtDt" type="DateFormat48Choice">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">EarliestPaymentDate</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Date/Time on which the posting / draft of the securities is scheduled to take place for a transaction.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="TaxAdjstmntRate" type="PercentageRate">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">TaxAdjustmentRate</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Set of the DTC legacy sub reason codes representing tax rate. Used with reason codes ‘TJXD’ ‘TJXF’ ‘TJXI’ ‘TJXL’ ‘TJXR’ ‘TJXT’ ‘TJXU’ to identify the correct tax rate.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="RDPRefNb" type="Exact32AlphaNumericText">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RDPReferenceNumber</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Unique DTCC legacy reference used for matching and reconciling legacy CCF records. The element will be populated to all levels of the message (event details, options, movements) where applicable to indicate how values are sourced from CCF legacy files. For example: event has 2 related activity types 74, and 54. If event details and cash option are sourced from the activity type 74, then activity type 74 will be in RDP reference number in event details, and also on the cash option. The activity type 54 will be "on" the security option. Also, usage rules will specify the different layouts of the RDP reference number based on DTCC event group (reorganization, distribution, or redemption).</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CorporateActionSD18">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">CorporateActionSD18</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Provides additional information regarding corporate action details.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="0" name="PlcAndNm" type="Max350Text">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">PlaceAndName</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Xpath to the element that is being extended.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="LtrySeqNb" type="Max3NumericText">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">LotterySequenceNumber</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">DTC generated number to distinguish between the series of lotteries run against a particular redemption.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="CreditDebitCode">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">CreditDebitCode</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Specifies if an operation is an increase or a decrease.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="CRDT">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">Credit</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Operation is an increase.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="DBIT">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">Debit</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Operation is a decrease.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DTCAdjustmentPaymentSubReason2Code">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">DTCAdjustmentPaymentSubReason2Code</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Specifies the subtype of the payment adjustment.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="SCPK">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">AccrualClaimPayment</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for an accrual claim payment related to a stock distribution payable on user defined date.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SACP">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">AccruedInterestNotPaid</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is that accrued interest was not previously paid to you for the redemption in this issue. This adjustment is to pay you for this accrued interest.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SACA">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">AccruedInterestWrongRate</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for the accrued interest previously paid to you was at the wrong rate. This adjustment is to correct that erroneous payment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SRTJ">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">AdditionalRightsForBeneficialOwner</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for a distribution of additional rights for round up of fractions as requested for your beneficial owners.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SSRJ">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">AllocationAdjustmentDueToFractionsRoundedUpByAgent</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for an allocation adjustment due to fractions rounded up by the agent related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SST6">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">AllocationOfDRPTEDSInstruction</xs:documentation>
