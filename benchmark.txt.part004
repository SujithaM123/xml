                    <xs:documentation source="Name" xml:lang="EN">TenderFeeDeduction</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for interest adjusted due to tender fee deduction.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SAA7">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">UnfavourableRateMerger</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is that your account is being credited at the unfavourable rate (20%) as a result of the reorg merger paid on 4/2/93 (Armstrong Pharm to Medeva plc, effective 1/15/93). If entitled to favourable rate(15%), you must follow attached.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SAWA">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">UninsuredInterestWithheld</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for uninsured interest withheld as per FSLICN.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SRRA">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">VodaphoneADR</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for option to receive Vodafone Group American Depository Receipt at 11.354392 for every 100 ADRS.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SWL1">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithdrawalByTransferNotTransferredIntoClientsName</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for adjustment made for a withdrawal by transfer that was not transferred into your clients name by the record date.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SWM1">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithdrawalByTransferSetUpAfterCutOffDateTransferIntoClientsName</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason code is for adjustment made for a withdrawal by transfer set up after the cut off date made transfer into your clients name.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SJWT">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithdrawalTransferAdjustment</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for DTCC WT related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SBB2">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithdrawalTransferBuyBackWithdrawal</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is that your record date position was adjusted for a w/t buy back withdrawal.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SWTA">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithholdingTaxAdjustmentInUserDefinedCountry</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for adjustment to allocation to charge (user defined percentage) withholding tax in (user defined) country.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SRAH">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WrittenInquiry</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is in response to your written inquiry.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SJEW">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WriteOffReorganisation</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for write off reorganisation related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SPRA">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WrongRatePrincipal</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is that the principal previously paid to you was at the wrong rate. This adjustment is to correct that erroneous payment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
