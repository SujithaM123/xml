                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRR3">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">MandatoryOverThreeYearReorganisationDeposit</xs:documentation>
