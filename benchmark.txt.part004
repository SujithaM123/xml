        if (obj.getPyoutTp() != null) writeLeaf(w, "PyoutTp", obj.getPyoutTp().value());
        if (obj.getTxAmt() != null) write_RestrictedFINActiveCurrencyAndAmount(w, "TxAmt", obj.getTxAmt());
