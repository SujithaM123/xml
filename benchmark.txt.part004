#!/usr/bin/env python3
"""
Turns the JMH JSON results (results/*.json) plus results/space.json and results/heap.json
into the 3 plain-text summary tables requested:
  1. Benchmark | Type | Size | Avg us | Msg/sec | Alloc KB/msg | GC count | GC time ms
  2. Type | Size | Input KB | POJO KB | Output KB
  3. Type | Peak heap MB

Usage: python scripts/summarize_results.py [results_dir]
"""
import json
import sys
import glob
import os
from collections import defaultdict

RESULTS_DIR = sys.argv[1] if len(sys.argv) > 1 else "results"

THROUGHPUT_TO_PER_SEC = {
    "ops/ns": 1e9, "ops/us": 1e6, "ops/ms": 1e3, "ops/s": 1.0, "ops/sec": 1.0, "ops/min": 1.0 / 60,
}
TIME_TO_MICROS = {
    "ns/op": 1e-3, "us/op": 1.0, "ms/op": 1e3, "s/op": 1e6,
}


def to_per_sec(score, unit):
    return score * THROUGHPUT_TO_PER_SEC.get(unit, 1.0)


def to_micros(score, unit):
    return score * TIME_TO_MICROS.get(unit, 1.0)


NON_JMH_RESULT_FILES = {"space.json", "heap.json", "sample_manifest.json"}


def load_jmh_entries(results_dir):
    entries = []
    for path in glob.glob(os.path.join(results_dir, "*.json")):
        name = os.path.basename(path)
        if name in NON_JMH_RESULT_FILES:
            continue
        with open(path) as fh:
            try:
                data = json.load(fh)
            except json.JSONDecodeError:
                continue
        if isinstance(data, list):
            # Only keep entries that actually look like JMH benchmark results, so any other
            # stray JSON file in results/ (e.g. a future report) doesn't break the summary.
            entries.extend(e for e in data if isinstance(e, dict) and "benchmark" in e and "mode" in e)
    return entries


def print_table(headers, rows, widths=None):
    if widths is None:
        widths = [max(len(str(h)), *(len(str(r[i])) for r in rows)) + 2 if rows else len(str(h)) + 2
                  for i, h in enumerate(headers)]
    line = "".join(str(h).ljust(w) for h, w in zip(headers, widths))
    print(line)
    print("-" * len(line))
    for r in rows:
        print("".join(str(c).ljust(w) for c, w in zip(r, widths)))
    print()


def main():
    entries = load_jmh_entries(RESULTS_DIR)
    if not entries:
        print(f"No JMH result JSON files found in {RESULTS_DIR}/ (looked for *.json, excluding space.json/heap.json)")
    rows = defaultdict(dict)
    for e in entries:
        bench = e["benchmark"].rsplit(".", 1)[-1]
        params = e.get("params", {})
        type_ = params.get("type", "?")
        size = params.get("size", "?")
        key = (bench, type_, size)
        mode = e["mode"]
        pm = e["primaryMetric"]
        sm = e.get("secondaryMetrics", {})
        if mode == "avgt":
            rows[key]["avg_us"] = to_micros(pm["score"], pm["scoreUnit"])
            if "gc.alloc.rate.norm" in sm:
                rows[key]["alloc_kb"] = sm["gc.alloc.rate.norm"]["score"] / 1024.0
            if "gc.count" in sm:
                rows[key]["gc_count"] = sm["gc.count"]["score"]
            if "gc.time" in sm:
                rows[key]["gc_time_ms"] = sm["gc.time"]["score"]
        elif mode == "thrpt":
            rows[key]["msg_per_sec"] = to_per_sec(pm["score"], pm["scoreUnit"])

    print("=== Benchmark summary ===\n")
    headers = ["Benchmark", "Type", "Size", "Avg us", "Msg/sec", "Alloc KB/msg", "GC count", "GC time ms"]
    table = []
    for (bench, type_, size) in sorted(rows):
        r = rows[(bench, type_, size)]
        table.append([
            bench, type_, size,
            f"{r.get('avg_us', float('nan')):.2f}",
            f"{r.get('msg_per_sec', float('nan')):.1f}",
            f"{r.get('alloc_kb', float('nan')):.2f}",
            f"{r.get('gc_count', float('nan')):.2f}",
            f"{r.get('gc_time_ms', float('nan')):.2f}",
        ])
    print_table(headers, table)

    space_path = os.path.join(RESULTS_DIR, "space.json")
    if os.path.exists(space_path):
        with open(space_path) as fh:
            space = json.load(fh)
        print("=== Space summary ===\n")
        headers = ["Type", "Size", "Input KB", "POJO KB", "Output KB"]
        table = [[s["type"], s["size"], f"{s['inputKB']:.2f}", f"{s['pojoKB']:.2f}", f"{s['outputKB']:.2f}"]
                 for s in space]
        print_table(headers, table)

    heap_path = os.path.join(RESULTS_DIR, "heap.json")
    if os.path.exists(heap_path):
        with open(heap_path) as fh:
            heap = json.load(fh)
        print("=== Peak heap summary ===\n")
        headers = ["Type", "Messages", "Peak heap MB"]
        table = [[h["type"], h["messages"], f"{h['peakHeapMB']:.2f}"] for h in heap]
        print_table(headers, table)

    gc_manual_path = os.path.join(RESULTS_DIR, "gc_manual.csv")
    if os.path.exists(gc_manual_path):
        import csv
        gc_rows = defaultdict(lambda: {"count_sum": 0.0, "time_sum": 0.0, "n": 0})
        with open(gc_manual_path, newline="") as fh:
            for row in csv.DictReader(fh):
                bench = row["benchmark"].rsplit(".", 1)[-1]
                key = (bench, row["type"], row["size"])
                gc_rows[key]["count_sum"] += float(row["gcCountDelta"])
                gc_rows[key]["time_sum"] += float(row["gcTimeMsDelta"])
                gc_rows[key]["n"] += 1
        print("=== Supplementary manual GC delta (GarbageCollectorMXBean, per iteration incl. warmup) ===")
        print("JVM-fork-level counters -- not exclusively attributable to one operation.\n")
        headers = ["Benchmark", "Type", "Size", "Iterations", "AvgGCcount/iter", "AvgGCtimeMs/iter"]
        table = []
        for (bench, type_, size), agg in sorted(gc_rows.items()):
            n = agg["n"]
            table.append([bench, type_, size, n, f"{agg['count_sum']/n:.3f}", f"{agg['time_sum']/n:.3f}"])
        print_table(headers, table)


if __name__ == "__main__":
    main()

@@@=== FILE END ===
@@@=== FILE START: SIMPLE_EXPLANATION.md ===
# What This Project Does (Explained Simply)

This project answers one question:

**"How fast can a computer read an XML file into Java objects, and write Java objects back into an XML file?"**

That's it. Everything else in this project exists just to test that, fairly and honestly.

---

## 1. The basic building blocks (explained like you're new to this)

### What is XML?
XML is just text that stores data with labels, like a filled-in form.

```xml
<Payment>
  <Amount>100.50</Amount>
  <Currency>USD</Currency>
</Payment>
```

This says: "there is a Payment, its Amount is 100.50, its Currency is USD."

### What is an XSD?
An XSD is the **rulebook** for an XML file. It says things like:
- "Amount must be a number."
- "Currency must be exactly 3 letters."
- "You must always include a Payment, but the Comment is optional."

Think of it like a form template that says which boxes are required and what kind of answer goes in each box.

This project has **4 XSD rulebooks** (4 kinds of forms), because it's testing 4 real-world financial messages used by banks (things like "a payment confirmation" and "a payment preview").

### What is a POJO?
POJO means "Plain Old Java Object." It's just a simple Java box that holds data in memory.

If the XML says `<Amount>100.50</Amount>`, the matching Java box (POJO) has a field like:
```java
BigDecimal amount = 100.50;
```

So: **XML is the text version. POJO is the "in Java's memory" version.** They hold the same information, just in different shapes.

### What is xjc?
`xjc` is a tool that **reads an XSD rulebook and auto-generates the Java boxes (POJOs) for you**, so you don't have to type them by hand. This project has 4 XSDs, so xjc created 4 sets of Java boxes — about 280 Java classes in total.

### What does "read XML into a POJO" mean?
It means: take the text file, understand it, and fill in the matching Java boxes with the right values.

### What does "write a POJO into XML" mean?
It's the reverse: take the filled-in Java boxes, and write out the matching text file.

### What is StAX?
StAX is a way of reading/writing XML **one little piece at a time**, like reading a book one word at a time with your finger, instead of photographing the whole page at once.

This matters for big files: if a file is 10 MB, you don't want to load the *whole* thing into memory as one blob before you even start — StAX lets you process it piece by piece, which uses less memory.

There's another common way to handle XML called JAXB, which can automatically read/write XML using "reflection" (a slower, more automatic, more magical approach). This project deliberately does **not** use that for the actual speed test — it uses **hand-style StAX code** instead, because hand-written code is usually faster. (More on how that code was created, below.)

---

## 2. What was actually built, step by step

### Step 1 — Turn the 4 rulebooks (XSDs) into Java boxes (POJOs)
Using `xjc`, automatically, at build time. No one typed these 280 classes by hand.

### Step 2 — Create fake-but-realistic sample XML files to test with
We didn't have any real XML files lying around, so a small program was written that:
- Reads each XSD rulebook.
- Makes up realistic-looking data that **obeys every rule** in that rulebook (right date formats, real currency codes like USD/EUR, valid ID patterns, etc.) — not just random junk.
- Saves the result as an XML file.
- Double-checks the XML file actually follows the rulebook (this is called "validation").

This was done for **5 different file sizes** (tiny ~10 KB, medium ~100 KB, big ~1 MB, bigger ~5 MB, huge ~10 MB), 4 message types, 5 copies of each = **100 sample XML files total.**

> Fun fact: making a file hit an exact target size (like "exactly 5 MB") is harder than it sounds, because XML files have lists inside lists inside lists, and each list can repeat. The first version of this size-control logic actually ran out of computer memory trying to build a 5 MB file, because it guessed the wrong repeat count and the file size exploded way past what was asked. This got fixed by having the program "learn" from 2 small test attempts first (figure out the real growth pattern), instead of blindly guessing.

### Step 3 & 4 — Write the actual "reader" and "writer" code
This is the important part: the code that actually converts **XML → Java boxes** (the reader) and **Java boxes → XML** (the writer), using StAX, by hand style, with no shortcuts (no reflection, no auto-magic tools) in the part that gets timed.

Writing this by hand for 280 Java classes would take forever and be very error-prone. So instead, a **one-time helper tool** was built that:
- Looks at the already-generated Java boxes (from Step 1).
- Figures out, automatically, what each box's fields are called and what type they are.
- Writes out plain, ordinary-looking Java code that reads/writes each box, field by field.

This helper tool is only used **once**, like a one-time favor, to save a huge amount of typing. The actual code it produces — the code that gets *timed* in the speed test — is plain, boring, hand-style Java. No shortcuts are used while the clock is running.

### Correctness check (very important — never skip this!)
Before trusting any speed numbers, we have to make sure the reading/writing code is actually **correct**. So for every one of the 100 sample files, we do:

1. Read the XML into Java boxes.
2. Write those boxes back out to XML.
3. Check: does this new XML still follow the rulebook? (validate again)
4. Read that new XML into Java boxes again (a second time).
5. Compare: do the "first time" boxes and the "second time" boxes contain exactly the same data?

If all 5 steps succeed for all 100 files, we know the reader and writer are trustworthy. **All 100 passed.**

### Step 5 — The actual speed test (benchmarking)
This uses a tool called **JMH** (Java Microbenchmark Harness) — basically a very careful stopwatch for code, built specifically because a normal stopwatch would give you wrong/misleading numbers for things this fast.

Why not just use `System.currentTimeMillis()` yourself? Because:
- The first few times code runs, Java is still "warming up" (compiling itself to be faster) — timing that gives you a lie.
- A smart compiler might notice "this result is never used" and skip the work entirely, making it look impossibly fast.

JMH handles both problems automatically. It runs the code many times, throws away the "still warming up" runs, and makes sure results are actually used (via something literally called a "Blackhole" — you feed it the result so nothing gets thrown away early).

Three things get timed:
1. **Reading** XML into Java boxes.
2. **Writing** Java boxes into XML.
3. **Both together** (read then write).

...for each of the 4 message types, at each of the 5 sizes. That's 20 combinations, times 3 timed things = 60 separate speed tests.

### What gets measured
- **Average time** — how many microseconds does one read (or write) take, on average?
- **Throughput** — how many messages per second can we process?
- **Memory garbage created** — processing XML creates lots of small temporary Java objects that need cleanup later. We measure how much "trash" gets created per message.
- **Garbage collection (GC) count & time** — Java has a built-in "cleaning crew" (the Garbage Collector) that automatically cleans up memory you're no longer using. We count how often the cleaning crew had to run, and how long cleaning took. (If cleaning runs a lot, that can slow things down.)
- **Peak memory (heap) usage** — if you process 10,000 messages back-to-back, what's the most memory that was ever in use at one time?
- **File sizes** — how big is the XML text file, versus how big is the same data once it's sitting in Java's memory as objects? (Usually bigger in memory than as compressed text.)

### Turning numbers into a readable report
All these measurements get saved as computer-readable files (JSON/CSV). A small script then reads all of that and prints out neat, simple tables — so a human doesn't have to dig through raw data files.

---

## 3. Why this is trustworthy (not just made-up numbers)

- Every sample XML file is checked against its rulebook (XSD) — twice.
- Every read/write round-trip is checked for exact data match.
- The reading/writing code itself never uses the JAXB automatic-magic tool, and never uses reflection — only plain, hand-style code, matching what a careful human engineer would write.
- The timing uses JMH, the standard professional tool for this exact job, not a hand-rolled stopwatch.
- The memory-cleanup (GC) numbers are measured **two separate ways** that agree with each other, for extra confidence.
- Nothing is estimated or guessed — every number in the report comes from an actual run that really happened on this machine.

---

## 4. One-sentence summary of every file

| File | One-sentence job |
|---|---|
| `xsd/*.xsd` | The 4 rulebooks for the 4 message types. |
| `com.bench.generator` | Makes 100 realistic, rule-following sample XML files. |
| `com.bench.codegen.StaxCodeGenerator` | A one-time helper that writes the reader/writer code for us, so we don't type 280 classes by hand. |
| `com.bench.stax.*` | The actual hand-style reader & writer code that gets speed-tested. |
| `com.bench.check.RoundTripCheck` | Makes sure the reader/writer are correct before we trust any speed number. |
| `com.bench.load.SpaceReport` | Measures file size vs. in-memory size. |
| `com.bench.load.PeakHeapLoadTest` | Measures the most memory ever used while processing 10,000 messages. |
| `StaxBenchmark` (JMH) | The actual stopwatch test: how fast is reading, writing, and both together? |
| `scripts/summarize_results.py` | Turns raw measurement files into easy-to-read tables. |

---

## 5. The simplest possible one-paragraph version

We have 4 kinds of financial message "forms" (XSDs). We taught the computer to fill out 100 fake-but-valid sample forms. We wrote (mostly by having a helper tool write it for us) plain, careful Java code that can turn those forms into Java objects and back into forms, without using any slow automatic shortcuts. We checked, very carefully, that converting back and forth never loses or changes any data. Then we used a professional timing tool to measure exactly how fast all of this is, how much temporary memory garbage it creates, and how much memory it uses at its peak — and saved all of that into clear, simple tables.

@@@=== FILE END ===
@@@=== FILE START: src/jmh/java/com/bench/StaxBenchmark.java ===
package com.bench;

import com.bench.stax.*;
import org.openjdk.jmh.annotations.*;
import org.openjdk.jmh.infra.Blackhole;
import org.openjdk.jmh.infra.BenchmarkParams;

import java.io.IOException;
import java.lang.management.GarbageCollectorMXBean;
import java.lang.management.ManagementFactory;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardOpenOption;
import java.util.List;
import java.util.Map;
import java.util.concurrent.TimeUnit;
import java.util.function.Function;

/**
 * B3 (XML bytes -> POJO), B6 (POJO -> XML bytes) and a combined round trip, for each of the 4
 * message types at each of the 5 sample sizes. All sample XMLs are loaded into memory in
 * @Setup (not timed); for B6 the POJO is also pre-built in @Setup so only writing is timed.
 *
 * <p>GC is reported two ways: JMH's own {@code -prof gc} (which itself reads
 * {@code GarbageCollectorMXBean} / {@code MemoryPoolMXBean} deltas around each measurement
 * iteration -- the standard, authoritative source), and a supplementary manual
 * {@code GarbageCollectorMXBean} delta captured in {@code @Setup}/{@code @TearDown(Level.Iteration)}
 * and appended to {@code results/gc_manual.csv}, for transparency and as a fallback when
 * {@code -prof gc} isn't used. Both are JVM-fork-level counters: they include any GC activity
 * from JIT warmup, JMH's own bookkeeping, or other code running in that same fork, not only the
 * benchmarked method -- they are not forced inside timed methods and are not claimed to be
 * attributable exclusively to one operation.</p>
 */
@State(Scope.Benchmark)
@BenchmarkMode({Mode.AverageTime, Mode.Throughput})
@OutputTimeUnit(TimeUnit.MICROSECONDS)
@Warmup(iterations = 5)
@Measurement(iterations = 5)
@Fork(2)
public class StaxBenchmark {

    @Param({"capa_seev035", "capa_supl009", "caco_seev036", "caco_supl011"})
    public String type;

    @Param({"small", "medium", "large", "xlarge", "xxl"})
    public String size;

    private Function<byte[], Object> reader;
    private Function<Object, byte[]> writer;
    private byte[] xmlBytes;
    private Object prebuiltPojo;

    private static final Map<String, Function<byte[], Object>> READERS = Map.of(
            "capa_seev035", bytes -> unchecked(() -> CapaSeev035StaxReader.read(bytes)),
            "capa_supl009", bytes -> unchecked(() -> CapaSupl009StaxReader.read(bytes)),
            "caco_seev036", bytes -> unchecked(() -> CacoSeev036StaxReader.read(bytes)),
            "caco_supl011", bytes -> unchecked(() -> CacoSupl011StaxReader.read(bytes))
    );

    private static final Map<String, Function<Object, byte[]>> WRITERS = Map.of(
            "capa_seev035", obj -> unchecked(() -> CapaSeev035StaxWriter.write((com.bench.capa.seev035.Document) obj)),
            "capa_supl009", obj -> unchecked(() -> CapaSupl009StaxWriter.write((com.bench.capa.supl009.Document) obj)),
            "caco_seev036", obj -> unchecked(() -> CacoSeev036StaxWriter.write((com.bench.caco.seev036.Document) obj)),
            "caco_supl011", obj -> unchecked(() -> CacoSupl011StaxWriter.write((com.bench.caco.supl011.Document) obj))
    );

    @Setup(Level.Trial)
    public void setup() throws IOException {
        reader = READERS.get(type);
        writer = WRITERS.get(type);
        Path file = Path.of("samples", type, size, "sample_1.xml");
        xmlBytes = Files.readAllBytes(file);
        prebuiltPojo = reader.apply(xmlBytes);
    }

    // --- Supplementary manual GC delta, captured around each iteration (warmup + measurement) ---

    private static final List<GarbageCollectorMXBean> GC_BEANS = ManagementFactory.getGarbageCollectorMXBeans();
    private static final Object GC_CSV_LOCK = new Object();

    private long gcCountAtIterationStart;
    private long gcTimeAtIterationStart;

    @Setup(Level.Iteration)
    public void setupIteration() {
        gcCountAtIterationStart = totalGcCount();
        gcTimeAtIterationStart = totalGcTimeMs();
    }

    @TearDown(Level.Iteration)
    public void teardownIteration(BenchmarkParams params) throws IOException {
        long countDelta = totalGcCount() - gcCountAtIterationStart;
        long timeDelta = totalGcTimeMs() - gcTimeAtIterationStart;
        appendGcRecord(params.getBenchmark(), type, size, countDelta, timeDelta);
    }

    private static long totalGcCount() {
        long sum = 0;
        for (GarbageCollectorMXBean bean : GC_BEANS) {
            long c = bean.getCollectionCount();
            if (c >= 0) sum += c;
        }
        return sum;
    }

    private static long totalGcTimeMs() {
        long sum = 0;
        for (GarbageCollectorMXBean bean : GC_BEANS) {
            long t = bean.getCollectionTime();
            if (t >= 0) sum += t;
        }
        return sum;
    }

    private static void appendGcRecord(String benchmark, String type, String size, long gcCountDelta, long gcTimeMsDelta)
            throws IOException {
        synchronized (GC_CSV_LOCK) {
            Path path = Path.of("results", "gc_manual.csv");
            Files.createDirectories(path.getParent());
            boolean isNew = !Files.exists(path);
            try (var w = Files.newBufferedWriter(path, StandardOpenOption.CREATE, StandardOpenOption.APPEND)) {
                if (isNew) {
                    w.write("benchmark,type,size,gcCountDelta,gcTimeMsDelta\n");
                }
                w.write(benchmark + "," + type + "," + size + "," + gcCountDelta + "," + gcTimeMsDelta + "\n");
            }
        }
    }

    @Benchmark
    public void b3_xmlToPojo(Blackhole bh) {
        bh.consume(reader.apply(xmlBytes));
    }

    @Benchmark
    public void b6_pojoToXml(Blackhole bh) {
        bh.consume(writer.apply(prebuiltPojo));
    }

    @Benchmark
    public void roundTrip(Blackhole bh) {
        Object pojo = reader.apply(xmlBytes);
        bh.consume(writer.apply(pojo));
    }

    private interface ThrowingSupplier<T> {
        T get() throws Exception;
    }

    private static <T> T unchecked(ThrowingSupplier<T> supplier) {
        try {
            return supplier.get();
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }
}

@@@=== FILE END ===
@@@=== FILE START: src/main/java/com/bench/check/RoundTripCheck.java ===
package com.bench.check;

import com.bench.stax.*;

import javax.xml.XMLConstants;
import javax.xml.datatype.XMLGregorianCalendar;
import javax.xml.transform.stream.StreamSource;
import javax.xml.validation.Schema;
import javax.xml.validation.SchemaFactory;
import javax.xml.validation.Validator;
import java.io.ByteArrayInputStream;
import java.io.File;
import java.lang.reflect.Field;
import java.math.BigDecimal;
import java.math.BigInteger;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.List;
import java.util.function.Function;

/**
 * For every generated sample XML: XML -&gt; POJO -&gt; XML, validates the regenerated XML
 * against its XSD, and deep-compares the two POJO graphs field by field. All must pass before
 * the JMH benchmarks are trusted.
 *
 * <p>Uses reflection only here, in the check tool -- never in the StAX reader/writer path that
 * is actually benchmarked.</p>
 */
public final class RoundTripCheck {

    private record TypeBinding(String typeKey, String xsdFileName, Function<byte[], Object> read,
                                Function<Object, byte[]> write) {
    }

    private static final List<TypeBinding> BINDINGS = List.of(
            new TypeBinding("capa_seev035", "SR_2025_Corporate_Action_CAPA_seev_035_001_16.xsd",
                    bytes -> unchecked(() -> CapaSeev035StaxReader.read(bytes)),
                    obj -> unchecked(() -> CapaSeev035StaxWriter.write((com.bench.capa.seev035.Document) obj))),
            new TypeBinding("capa_supl009", "SR_2025_Corporate_Action_CAPA_Extension_supl_009_001_11.xsd",
                    bytes -> unchecked(() -> CapaSupl009StaxReader.read(bytes)),
                    obj -> unchecked(() -> CapaSupl009StaxWriter.write((com.bench.capa.supl009.Document) obj))),
            new TypeBinding("caco_seev036", "SR_2025_Corporate_Action_CACO_seev_036_001_16.xsd",
                    bytes -> unchecked(() -> CacoSeev036StaxReader.read(bytes)),
                    obj -> unchecked(() -> CacoSeev036StaxWriter.write((com.bench.caco.seev036.Document) obj))),
            new TypeBinding("caco_supl011", "SR_2025_Corporate_Action_CACO_Extension_supl_011_001_11.xsd",
                    bytes -> unchecked(() -> CacoSupl011StaxReader.read(bytes)),
                    obj -> unchecked(() -> CacoSupl011StaxWriter.write((com.bench.caco.supl011.Document) obj)))
    );

    private interface ThrowingSupplier<T> {
        T get() throws Exception;
    }

    private static <T> T unchecked(ThrowingSupplier<T> supplier) {
        try {
            return supplier.get();
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    public static void main(String[] args) throws Exception {
        File xsdDir = new File("xsd");
        File samplesDir = new File("samples");
        SchemaFactory schemaFactory = SchemaFactory.newInstance(XMLConstants.W3C_XML_SCHEMA_NS_URI);

        int passed = 0, failed = 0;
        System.out.println("Type           Size     File                XsdValid  FieldsMatch  Result");
        System.out.println("----           ----     ----                --------  -----------  ------");

        for (TypeBinding binding : BINDINGS) {
            Schema schema = schemaFactory.newSchema(new File(xsdDir, binding.xsdFileName()));
            File typeDir = new File(samplesDir, binding.typeKey());
            for (File sizeDir : sortedDirs(typeDir)) {
                for (File file : sortedFiles(sizeDir)) {
                    byte[] original = Files.readAllBytes(file.toPath());

                    Object pojo1 = binding.read().apply(original);
                    byte[] regenerated = binding.write().apply(pojo1);
                    boolean xsdValid = validate(schema, regenerated);
                    Object pojo2 = binding.read().apply(regenerated);
                    boolean fieldsMatch = deepEquals(pojo1, pojo2);

                    boolean ok = xsdValid && fieldsMatch;
                    if (ok) passed++; else failed++;

                    System.out.printf("%-14s %-8s %-19s %-9s %-12s %s%n",
                            binding.typeKey(), sizeDir.getName(), file.getName(),
                            xsdValid ? "PASS" : "FAIL", fieldsMatch ? "PASS" : "FAIL", ok ? "PASS" : "FAIL");
                }
            }
        }

        System.out.println();
        System.out.println("Total passed: " + passed + ", failed: " + failed);
        if (failed > 0) {
            System.exit(1);
        }
    }

    private static File[] sortedDirs(File dir) {
        File[] arr = dir.listFiles(File::isDirectory);
        if (arr == null) return new File[0];
        java.util.Arrays.sort(arr);
        return arr;
    }

    private static File[] sortedFiles(File dir) {
        File[] arr = dir.listFiles(File::isFile);
        if (arr == null) return new File[0];
        java.util.Arrays.sort(arr);
        return arr;
    }

    private static boolean validate(Schema schema, byte[] xml) {
        try {
            Validator validator = schema.newValidator();
            validator.validate(new StreamSource(new ByteArrayInputStream(xml)));
            return true;
        } catch (Exception e) {
            System.err.println("  xsd validation error: " + e.getMessage());
            return false;
        }
    }

    private static boolean deepEquals(Object a, Object b) {
        if (a == b) {
            return true;
        }
        if (a == null || b == null) {
            return false;
        }
        if (a instanceof List<?> la) {
            List<?> lb = (List<?>) b;
            if (la.size() != lb.size()) {
                return false;
            }
            for (int i = 0; i < la.size(); i++) {
                if (!deepEquals(la.get(i), lb.get(i))) {
                    return false;
                }
            }
            return true;
        }
        if (a instanceof BigDecimal da) {
            return b instanceof BigDecimal db && da.compareTo(db) == 0;
        }
        if (a instanceof XMLGregorianCalendar ca) {
            return b instanceof XMLGregorianCalendar cb && ca.toXMLFormat().equals(cb.toXMLFormat());
        }
        if (a instanceof String || a instanceof Boolean || a instanceof BigInteger || a.getClass().isEnum()) {
            return a.equals(b);
        }
        if (!a.getClass().getName().startsWith("com.bench.")) {
            return a.equals(b);
        }
        if (a.getClass() != b.getClass()) {
            return false;
        }
        try {
            for (Field f : a.getClass().getDeclaredFields()) {
                f.setAccessible(true);
                if (!deepEquals(f.get(a), f.get(b))) {
                    System.err.println("  field mismatch: " + a.getClass().getSimpleName() + "." + f.getName());
                    return false;
                }
            }
            return true;
        } catch (IllegalAccessException e) {
            throw new RuntimeException(e);
        }
    }
}

@@@=== FILE END ===
@@@=== FILE START: src/main/java/com/bench/codegen/StaxCodeGenerator.java ===
package com.bench.codegen;

import jakarta.xml.bind.annotation.XmlAnyElement;
import jakarta.xml.bind.annotation.XmlAttribute;
import jakarta.xml.bind.annotation.XmlElement;
import jakarta.xml.bind.annotation.XmlType;
import jakarta.xml.bind.annotation.XmlValue;

import java.lang.reflect.Field;
import java.lang.reflect.ParameterizedType;
import java.math.BigDecimal;
import java.math.BigInteger;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;
import javax.xml.datatype.XMLGregorianCalendar;

/**
 * Build-time tool (not part of the benchmarked path): reflects once on the already-compiled
 * xjc POJOs to emit plain, hand-written-style StAX reader/writer .java source files -- one
 * reader + one writer per message type, with zero reflection and zero JAXB marshal/unmarshal
 * calls in the generated code itself.
 *
 * <p>Run after `mvn compile` (needs the xjc classes on the classpath), before the main
 * compile that will pick up its output under src/main/java/com/bench/stax/.</p>
 */
public final class StaxCodeGenerator {

    private static final Path OUT_DIR = Path.of("src/main/java/com/bench/stax");

    public static void main(String[] args) throws Exception {
        Files.createDirectories(OUT_DIR);
        generate("com.bench.capa.seev035", "CapaSeev035", "urn:iso:std:iso:20022:tech:xsd:seev.035.001.16");
        generate("com.bench.capa.supl009", "CapaSupl009", "urn:iso:std:iso:20022:tech:xsd:supl.009.001.11");
        generate("com.bench.caco.seev036", "CacoSeev036", "urn:iso:std:iso:20022:tech:xsd:seev.036.001.16");
        generate("com.bench.caco.supl011", "CacoSupl011", "urn:iso:std:iso:20022:tech:xsd:supl.011.001.11");
        System.out.println("StAX reader/writer source generated into " + OUT_DIR);
    }

    private static void generate(String pojoPackage, String prefix, String namespace) throws Exception {
        Class<?> documentClass = Class.forName(pojoPackage + ".Document");

        Set<Class<?>> types = new LinkedHashSet<>();
        collectTypes(documentClass, pojoPackage, types);

        String reader = generateReader(prefix, pojoPackage, types, namespace);
        String writer = generateWriter(prefix, pojoPackage, types, namespace);

        Files.writeString(OUT_DIR.resolve(prefix + "StaxReader.java"), reader);
        Files.writeString(OUT_DIR.resolve(prefix + "StaxWriter.java"), writer);
    }

    // ---- Discovery ----------------------------------------------------------------------

    private static void collectTypes(Class<?> clazz, String pojoPackage, Set<Class<?>> seen) {
        if (clazz.isEnum() || !seen.add(clazz)) {
            return;
        }
        for (Field f : clazz.getDeclaredFields()) {
            Class<?> elementType = List.class.isAssignableFrom(f.getType()) ? listElementType(f) : f.getType();
            if (elementType != null && elementType.getName().startsWith(pojoPackage)) {
                collectTypes(elementType, pojoPackage, seen);
            }
        }
    }

    private static Class<?> listElementType(Field f) {
        if (f.getGenericType() instanceof ParameterizedType pt) {
            return (Class<?>) pt.getActualTypeArguments()[0];
        }
        return null;
    }

    private static List<Field> propOrderFields(Class<?> c) {
        XmlType xmlType = c.getAnnotation(XmlType.class);
        List<Field> fields = new java.util.ArrayList<>();
        if (xmlType != null) {
            for (String name : xmlType.propOrder()) {
                if (name.isEmpty() || name.equals("##default")) {
                    continue;
                }
                try {
                    fields.add(c.getDeclaredField(name));
                } catch (NoSuchFieldException e) {
                    throw new IllegalStateException("propOrder field not found: " + name + " on " + c, e);
                }
            }
        }
        return fields;
    }

    private static List<Field> attributeFields(Class<?> c) {
        List<Field> fields = new java.util.ArrayList<>();
        for (Field f : c.getDeclaredFields()) {
            if (f.isAnnotationPresent(XmlAttribute.class)) {
                fields.add(f);
            }
        }
        return fields;
    }

    private static String xmlElementName(Field f) {
        XmlElement ann = f.getAnnotation(XmlElement.class);
        if (ann != null && !ann.name().equals("##default")) {
            return ann.name();
        }
        return capitalize(f.getName());
    }

    private static String xmlAttributeName(Field f) {
        return f.getAnnotation(XmlAttribute.class).name();
    }

    private static String capitalize(String s) {
        return Character.toUpperCase(s.charAt(0)) + s.substring(1);
    }

    /**
     * xjc names the getter/setter after the original XML name verbatim (e.g. field "isin" but
     * {@code getISIN()}; field "rdpRefNb" but {@code getRDPRefNb()}) -- not by re-capitalizing
     * the decapitalized field name. @XmlValue ("value") and @XmlAnyElement ("any") fields have
     * no XML element name, so those fall back to capitalizing the field name itself.
     */
    private static String accessorSuffix(Field f) {
        if (f.isAnnotationPresent(XmlAttribute.class)) {
            return xmlAttributeName(f);
        }
        XmlElement ann = f.getAnnotation(XmlElement.class);
        if (ann != null && !ann.name().equals("##default")) {
            return ann.name();
        }
        return capitalize(f.getName());
    }

    private static String getterPrefix(Class<?> type) {
        return (type == boolean.class || type == Boolean.class) ? "is" : "get";
    }

    private static boolean isAnyElement(Field f) {
        return f.isAnnotationPresent(XmlAnyElement.class);
    }

    // ---- Reader generation ---------------------------------------------------------------

    private static String generateReader(String prefix, String pojoPackage, Set<Class<?>> types, String namespace) {
        StringBuilder sb = new StringBuilder();
        sb.append("package com.bench.stax;\n\n");
        sb.append("import ").append(pojoPackage).append(".*;\n");
        sb.append("import javax.xml.stream.XMLInputFactory;\n");
        sb.append("import javax.xml.stream.XMLStreamConstants;\n");
        sb.append("import javax.xml.stream.XMLStreamException;\n");
        sb.append("import javax.xml.stream.XMLStreamReader;\n");
        sb.append("import javax.xml.datatype.DatatypeFactory;\n");
        sb.append("import java.io.ByteArrayInputStream;\n");
        sb.append("import java.math.BigDecimal;\n");
        sb.append("import java.math.BigInteger;\n\n");
        sb.append("/** Hand-written-style StAX reader for ").append(prefix).append(" (generated once from the xjc POJOs; no reflection or JAXB unmarshalling at runtime). */\n");
        sb.append("public final class ").append(prefix).append("StaxReader {\n\n");
        sb.append("    private static final XMLInputFactory INPUT_FACTORY = XMLInputFactory.newFactory();\n");
        sb.append("    private static final DatatypeFactory DATATYPE_FACTORY;\n");
        sb.append("    static {\n");
        sb.append("        try {\n");
        sb.append("            DATATYPE_FACTORY = DatatypeFactory.newInstance();\n");
        sb.append("        } catch (Exception e) {\n");
        sb.append("            throw new ExceptionInInitializerError(e);\n");
        sb.append("        }\n");
        sb.append("    }\n\n");
        sb.append("    private ").append(prefix).append("StaxReader() {\n    }\n\n");

        sb.append("    public static Document read(byte[] xml) throws XMLStreamException {\n");
        sb.append("        XMLStreamReader r = INPUT_FACTORY.createXMLStreamReader(new ByteArrayInputStream(xml));\n");
        sb.append("        r.nextTag();\n");
        sb.append("        Document doc = read_Document(r);\n");
        sb.append("        r.close();\n");
        sb.append("        return doc;\n");
        sb.append("    }\n\n");

        for (Class<?> c : types) {
            appendReaderMethod(sb, c);
        }

        sb.append("    private static void skip(XMLStreamReader r) throws XMLStreamException {\n");
        sb.append("        int depth = 1;\n");
        sb.append("        while (depth > 0) {\n");
        sb.append("            int ev = r.next();\n");
        sb.append("            if (ev == XMLStreamConstants.START_ELEMENT) depth++;\n");
        sb.append("            else if (ev == XMLStreamConstants.END_ELEMENT) depth--;\n");
        sb.append("        }\n");
        sb.append("    }\n");

        sb.append("}\n");
        return sb.toString();
    }

    private static void appendReaderMethod(StringBuilder sb, Class<?> c) {
        String cn = c.getSimpleName();
        List<Field> attrs = attributeFields(c);
        List<Field> allProps = propOrderFields(c);
        Field anyElement = allProps.stream().filter(StaxCodeGenerator::isAnyElement).findFirst().orElse(null);
        List<Field> props = allProps.stream().filter(f -> !isAnyElement(f)).toList();
        boolean simpleContent = props.size() == 1 && props.get(0).isAnnotationPresent(XmlValue.class);

        sb.append("    private static ").append(cn).append(" read_").append(cn).append("(XMLStreamReader r) throws XMLStreamException {\n");
        sb.append("        ").append(cn).append(" obj = new ").append(cn).append("();\n");
        for (Field a : attrs) {
            sb.append("        obj.set").append(accessorSuffix(a)).append('(')
                    .append(leafFromText(a.getType(), "r.getAttributeValue(null, \"" + xmlAttributeName(a) + "\")"))
                    .append(");\n");
        }
        if (simpleContent) {
            Field v = props.get(0);
            sb.append("        obj.set").append(accessorSuffix(v)).append('(')
                    .append(leafFromText(v.getType(), "r.getElementText()"))
                    .append(");\n");
            sb.append("        return obj;\n");
        } else {
            sb.append("        for (int ev = r.next(); ev != XMLStreamConstants.END_ELEMENT; ev = r.next()) {\n");
            sb.append("            if (ev != XMLStreamConstants.START_ELEMENT) continue;\n");
            sb.append("            switch (r.getLocalName()) {\n");
            for (Field p : props) {
                String xmlName = xmlElementName(p);
                boolean isList = List.class.isAssignableFrom(p.getType());
                if (isList) {
                    Class<?> elem = listElementType(p);
                    sb.append("                case \"").append(xmlName).append("\": obj.get").append(accessorSuffix(p))
                            .append("().add(").append(readCallFor(elem, "r")).append("); break;\n");
                } else {
                    sb.append("                case \"").append(xmlName).append("\": obj.set").append(accessorSuffix(p))
                            .append('(').append(readCallFor(p.getType(), "r")).append("); break;\n");
                }
            }
            if (anyElement != null) {
                sb.append("                default: obj.set").append(accessorSuffix(anyElement)).append("(r.getElementText()); break;\n");
            } else {
                sb.append("                default: skip(r); break;\n");
            }
            sb.append("            }\n");
            sb.append("        }\n");
            sb.append("        return obj;\n");
        }
        sb.append("    }\n\n");
    }

    private static String readCallFor(Class<?> type, String readerVar) {
        if (type.isEnum()) {
            return leafFromText(type, readerVar + ".getElementText()");
        }
        if (isKnownLeaf(type)) {
            return leafFromText(type, readerVar + ".getElementText()");
        }
        return "read_" + type.getSimpleName() + "(" + readerVar + ")";
    }

    private static String leafFromText(Class<?> type, String textExpr) {
        if (type == String.class) {
            return textExpr;
        }
        if (type == BigDecimal.class) {
            return "new BigDecimal(" + textExpr + ")";
        }
        if (type == BigInteger.class) {
            return "new BigInteger(" + textExpr + ")";
        }
        if (type == Boolean.class || type == boolean.class) {
            return "Boolean.parseBoolean(" + textExpr + ")";
        }
        if (type == XMLGregorianCalendar.class) {
            return "DATATYPE_FACTORY.newXMLGregorianCalendar(" + textExpr + ")";
        }
        if (type.isEnum()) {
            return type.getSimpleName() + ".fromValue(" + textExpr + ")";
        }
        return textExpr;
    }

    // ---- Writer generation ---------------------------------------------------------------

    private static String generateWriter(String prefix, String pojoPackage, Set<Class<?>> types, String namespace) {
        StringBuilder sb = new StringBuilder();
        sb.append("package com.bench.stax;\n\n");
        sb.append("import ").append(pojoPackage).append(".*;\n");
        sb.append("import javax.xml.stream.XMLOutputFactory;\n");
        sb.append("import javax.xml.stream.XMLStreamException;\n");
        sb.append("import javax.xml.stream.XMLStreamWriter;\n");
        sb.append("import java.io.ByteArrayOutputStream;\n\n");
        sb.append("/** Hand-written-style StAX writer for ").append(prefix).append(" (generated once from the xjc POJOs; no reflection or JAXB marshalling at runtime). */\n");
        sb.append("public final class ").append(prefix).append("StaxWriter {\n\n");
        sb.append("    private static final XMLOutputFactory OUTPUT_FACTORY = XMLOutputFactory.newFactory();\n\n");
        sb.append("    private ").append(prefix).append("StaxWriter() {\n    }\n\n");

        sb.append("    public static byte[] write(Document doc) throws XMLStreamException {\n");
        sb.append("        ByteArrayOutputStream out = new ByteArrayOutputStream();\n");
        sb.append("        XMLStreamWriter w = OUTPUT_FACTORY.createXMLStreamWriter(out, \"UTF-8\");\n");
        sb.append("        w.writeStartDocument(\"UTF-8\", \"1.0\");\n");
        sb.append("        write_Document(w, \"Document\", doc);\n");
        sb.append("        w.writeEndDocument();\n");
        sb.append("        w.flush();\n");
        sb.append("        w.close();\n");
        sb.append("        return out.toByteArray();\n");
        sb.append("    }\n\n");

        for (Class<?> c : types) {
            appendWriterMethod(sb, c, c.getSimpleName().equals("Document") ? namespace : null);
        }

        sb.append("    private static void writeLeaf(XMLStreamWriter w, String tag, String text) throws XMLStreamException {\n");
        sb.append("        w.writeStartElement(tag);\n");
        sb.append("        w.writeCharacters(text);\n");
        sb.append("        w.writeEndElement();\n");
        sb.append("    }\n");

        sb.append("}\n");
        return sb.toString();
    }

    private static void appendWriterMethod(StringBuilder sb, Class<?> c, String namespaceIfRoot) {
        String cn = c.getSimpleName();
        List<Field> attrs = attributeFields(c);
        List<Field> allProps = propOrderFields(c);
        Field anyElement = allProps.stream().filter(StaxCodeGenerator::isAnyElement).findFirst().orElse(null);
        List<Field> props = allProps.stream().filter(f -> !isAnyElement(f)).toList();
        boolean simpleContent = props.size() == 1 && props.get(0).isAnnotationPresent(XmlValue.class);

        sb.append("    private static void write_").append(cn).append("(XMLStreamWriter w, String tag, ").append(cn).append(" obj) throws XMLStreamException {\n");
        sb.append("        w.writeStartElement(tag);\n");
        if (namespaceIfRoot != null) {
            sb.append("        w.writeDefaultNamespace(\"").append(namespaceIfRoot).append("\");\n");
        }
        for (Field a : attrs) {
            String getter = "obj." + getterPrefix(a.getType()) + accessorSuffix(a) + "()";
            sb.append("        if (").append(getter).append(" != null) w.writeAttribute(\"").append(xmlAttributeName(a))
                    .append("\", ").append(leafToText(a.getType(), getter)).append(");\n");
        }
        if (simpleContent) {
            Field v = props.get(0);
            String getter = "obj." + getterPrefix(v.getType()) + accessorSuffix(v) + "()";
            sb.append("        w.writeCharacters(").append(leafToText(v.getType(), getter)).append(");\n");
        } else {
            for (Field p : props) {
                String xmlName = xmlElementName(p);
                boolean isList = List.class.isAssignableFrom(p.getType());
                if (isList) {
                    Class<?> elem = listElementType(p);
                    String getter = "obj.get" + accessorSuffix(p) + "()";
                    sb.append("        for (").append(elem.getSimpleName()).append(" item : ").append(getter).append(") ")
                            .append(writeCallFor(elem, "\"" + xmlName + "\"", "item")).append(";\n");
                } else {
                    String getter = "obj." + getterPrefix(p.getType()) + accessorSuffix(p) + "()";
                    String call = writeCallFor(p.getType(), "\"" + xmlName + "\"", getter);
                    if (p.getType().isPrimitive()) {
                        sb.append("        ").append(call).append(";\n"); // primitive: no minOccurs=0, always present
                    } else {
                        sb.append("        if (").append(getter).append(" != null) ").append(call).append(";\n");
                    }
                }
            }
            if (anyElement != null) {
                String getter = "obj.get" + accessorSuffix(anyElement) + "()";
                sb.append("        if (").append(getter).append(" != null) writeLeaf(w, \"SplmtryInfo\", String.valueOf(").append(getter).append("));\n");
            }
        }
        sb.append("        w.writeEndElement();\n");
        sb.append("    }\n\n");
    }

    private static String writeCallFor(Class<?> type, String tagExpr, String valueExpr) {
        if (!type.isEnum() && !isKnownLeaf(type)) {
            return "write_" + type.getSimpleName() + "(w, " + tagExpr + ", " + valueExpr + ")";
        }
        return "writeLeaf(w, " + tagExpr + ", " + leafToText(type, valueExpr) + ")";
    }

    private static String leafToText(Class<?> type, String valueExpr) {
        if (type == String.class) {
            return valueExpr;
        }
        if (type == BigDecimal.class || type == BigInteger.class) {
            return valueExpr + ".toString()";
        }
        if (type == Boolean.class || type == boolean.class) {
            return "String.valueOf(" + valueExpr + ")";
        }
        if (type == XMLGregorianCalendar.class) {
            return valueExpr + ".toXMLFormat()";
        }
        if (type.isEnum()) {
            return valueExpr + ".value()";
        }
        return "String.valueOf(" + valueExpr + ")";
    }

    private static boolean isKnownLeaf(Class<?> type) {
        return type == String.class || type == BigDecimal.class || type == BigInteger.class
                || type == Boolean.class || type == boolean.class || type == XMLGregorianCalendar.class;
    }
}

@@@=== FILE END ===
@@@=== FILE START: src/main/java/com/bench/generator/GenerateSamples.java ===
package com.bench.generator;

import javax.xml.XMLConstants;
import javax.xml.transform.stream.StreamSource;
import javax.xml.validation.Schema;
import javax.xml.validation.SchemaFactory;
import javax.xml.validation.Validator;
import java.io.ByteArrayInputStream;
import java.io.File;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Random;

/**
 * Generates 5 valid sample XMLs per (message type x size) into samples/<type>/<size>/,
 * then validates every generated file against its own XSD and prints a pass/fail summary.
 */
public final class GenerateSamples {

    private static final int VARIANTS_PER_SIZE = 5;

    public static void main(String[] args) throws Exception {
        File xsdDir = new File("xsd");
        File samplesDir = new File("samples");

        int totalPassed = 0;
        int totalFailed = 0;
        StringBuilder manifest = new StringBuilder("[\n");
        boolean firstManifestRow = true;

        System.out.println("Type           Size     File                Bytes       TargetBytes  Diff%    Valid");
        System.out.println("----           ----     ----                -----       -----------  -----    -----");

        for (MessageSpec spec : MessageSpec.ALL) {
            SchemaFactory schemaFactory = SchemaFactory.newInstance(XMLConstants.W3C_XML_SCHEMA_NS_URI);
            Schema schema = schemaFactory.newSchema(new File(xsdDir, spec.xsdFileName()));

            SampleXmlGenerator generator = new SampleXmlGenerator(xsdDir, spec);

            for (SizeTier tier : SizeTier.values()) {
                Path tierDir = samplesDir.toPath().resolve(spec.typeKey()).resolve(tier.folderName);
                Files.createDirectories(tierDir);

                for (int variant = 1; variant <= VARIANTS_PER_SIZE; variant++) {
                    Random rnd = new Random(seed(spec.typeKey(), tier.folderName, variant));
                    byte[] xml = generator.generateForTier(tier, rnd);

                    String fileName = "sample_" + variant + ".xml";
                    Path file = tierDir.resolve(fileName);
                    Files.write(file, xml);

                    boolean valid = validate(schema, xml);
                    if (valid) {
                        totalPassed++;
                    } else {
                        totalFailed++;
                    }

                    double diffPct = 100.0 * (xml.length - tier.targetBytes) / tier.targetBytes;
                    System.out.printf("%-14s %-8s %-19s %-11d %-12d %-8.1f %s%n",
                            spec.typeKey(), tier.folderName, fileName, xml.length, tier.targetBytes, diffPct,
                            valid ? "PASS" : "FAIL");

                    if (!firstManifestRow) manifest.append(",\n");
                    firstManifestRow = false;
                    manifest.append(String.format(java.util.Locale.ROOT,
                            "  {\"type\": \"%s\", \"size\": \"%s\", \"file\": \"%s\", \"actualBytes\": %d, "
                                    + "\"targetBytes\": %d, \"diffPct\": %.2f, \"valid\": %b}",
                            spec.typeKey(), tier.folderName, fileName, xml.length, tier.targetBytes, diffPct, valid));
                }
            }
        }
        manifest.append("\n]\n");
        Files.createDirectories(Path.of("results"));
        Files.writeString(Path.of("results", "sample_manifest.json"), manifest.toString());

        System.out.println();
        System.out.println("Total passed: " + totalPassed + ", failed: " + totalFailed);
        System.out.println("Per-file sizes and target-vs-actual differences recorded in results/sample_manifest.json");
        if (totalFailed > 0) {
            System.exit(1);
        }
    }

    private static long seed(String typeKey, String size, int variant) {
        return (long) typeKey.hashCode() * 31 + size.hashCode() * 17 + variant;
    }

    private static boolean validate(Schema schema, byte[] xml) {
        try {
            Validator validator = schema.newValidator();
            validator.validate(new StreamSource(new ByteArrayInputStream(xml)));
            return true;
        } catch (Exception e) {
            System.err.println("  validation error: " + e.getMessage());
            return false;
        }
    }
}

