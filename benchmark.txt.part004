    private static CorporateAction851 read_CorporateAction851(XMLStreamReader r) throws XMLStreamException {
        CorporateAction851 obj = new CorporateAction851();
        for (int ev = r.next(); ev != XMLStreamConstants.END_ELEMENT; ev = r.next()) {
            if (ev != XMLStreamConstants.START_ELEMENT) continue;
            switch (r.getLocalName()) {
                case "DtDtls": obj.setDtDtls(read_CorporateActionDate861(r)); break;
