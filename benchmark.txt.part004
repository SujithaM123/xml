                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRMD">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">MandatoryReorganisationDeposit</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Mandatory reorganisation deposit related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TJXO">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">OriginalInitialTaxWithholding</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Original (initial) tax withholding related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TJXL">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">OriginalLateTaxWithholding</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Original late tax withholding related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TJXT">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RateChangeTaxWithholding</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Rate change tax withholding related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="REPO">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RepoSettlement</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">REPO (repurchase agreement) transaction.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRRI">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RightsProtect</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Rights protect related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRRS">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RightsSales</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Rights sales related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRRU">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RightsStepUp</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Rights step up related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RRRE">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">RightsSubscription</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Rights subscription related adjustment.</xs:documentation>
                </xs:annotation>
