package com.bench.stax;

import com.bench.capa.supl009.*;
import javax.xml.stream.XMLOutputFactory;
import javax.xml.stream.XMLStreamException;
import javax.xml.stream.XMLStreamWriter;
import java.io.ByteArrayOutputStream;

/** Hand-written-style StAX writer for CapaSupl009 (generated once from the xjc POJOs; no reflection or JAXB marshalling at runtime). */
public final class CapaSupl009StaxWriter {

    private static final XMLOutputFactory OUTPUT_FACTORY = XMLOutputFactory.newFactory();

    private CapaSupl009StaxWriter() {
    }

    public static byte[] write(Document doc) throws XMLStreamException {
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        XMLStreamWriter w = OUTPUT_FACTORY.createXMLStreamWriter(out, "UTF-8");
        w.writeStartDocument("UTF-8", "1.0");
        write_Document(w, "Document", doc);
        w.writeEndDocument();
        w.flush();
        w.close();
        return out.toByteArray();
    }

    private static void write_Document(XMLStreamWriter w, String tag, Document obj) throws XMLStreamException {
        w.writeStartElement(tag);
        w.writeDefaultNamespace("urn:iso:std:iso:20022:tech:xsd:supl.009.001.11");
        if (obj.getDTCCCAPASD1() != null) write_DTCCCAPASD1V11(w, "DTCCCAPASD1", obj.getDTCCCAPASD1());
        w.writeEndElement();
    }

    private static void write_DTCCCAPASD1V11(XMLStreamWriter w, String tag, DTCCCAPASD1V11 obj) throws XMLStreamException {
        w.writeStartElement(tag);
        if (obj.getCorpActnGnlInf() != null) write_CorporateActionGeneralInformationSD58(w, "CorpActnGnlInf", obj.getCorpActnGnlInf());
        if (obj.getUndrlygScty() != null) write_FinancialInstrumentAttributesSD21(w, "UndrlygScty", obj.getUndrlygScty());
        if (obj.getCorpActnBalDtls() != null) write_CorporateActionBalanceSD4(w, "CorpActnBalDtls", obj.getCorpActnBalDtls());
        if (obj.getCorpActnDtls() != null) write_CorporateActionSD18(w, "CorpActnDtls", obj.getCorpActnDtls());
        for (CorporateActionMovementSecuritiesMovementDetailsSD5 item : obj.getCorpActnMvmntSctiesMvmntDtls()) write_CorporateActionMovementSecuritiesMovementDetailsSD5(w, "CorpActnMvmntSctiesMvmntDtls", item);
        for (CorporateActionMovementCashMovementDetailsSD5 item : obj.getCorpActnMvmntCshMvmntDtls()) write_CorporateActionMovementCashMovementDetailsSD5(w, "CorpActnMvmntCshMvmntDtls", item);
        for (OptionTransactionDetailsSD3 item : obj.getOptnTxDtls()) write_OptionTransactionDetailsSD3(w, "OptnTxDtls", item);
        w.writeEndElement();
    }

    private static void write_CorporateActionGeneralInformationSD58(XMLStreamWriter w, String tag, CorporateActionGeneralInformationSD58 obj) throws XMLStreamException {
        w.writeStartElement(tag);
        if (obj.getPlcAndNm() != null) writeLeaf(w, "PlcAndNm", obj.getPlcAndNm());
        if (obj.getEvtGrp() != null) writeLeaf(w, "EvtGrp", obj.getEvtGrp().value());
        if (obj.getEvtTp() != null) writeLeaf(w, "EvtTp", obj.getEvtTp().value());
        if (obj.getSubEvtTp() != null) writeLeaf(w, "SubEvtTp", obj.getSubEvtTp().value());
        if (obj.getRedId() != null) writeLeaf(w, "RedId", obj.getRedId());
        w.writeEndElement();
    }

    private static void write_FinancialInstrumentAttributesSD21(XMLStreamWriter w, String tag, FinancialInstrumentAttributesSD21 obj) throws XMLStreamException {
        w.writeStartElement(tag);
        if (obj.getPlcAndNm() != null) writeLeaf(w, "PlcAndNm", obj.getPlcAndNm());
        if (obj.getOrgtgSctyId() != null) write_OtherIdentification2(w, "OrgtgSctyId", obj.getOrgtgSctyId());
        if (obj.isMnyMktInstrmFlg() != null) writeLeaf(w, "MnyMktInstrmFlg", String.valueOf(obj.isMnyMktInstrmFlg()));
        w.writeEndElement();
    }

    private static void write_OtherIdentification2(XMLStreamWriter w, String tag, OtherIdentification2 obj) throws XMLStreamException {
        w.writeStartElement(tag);
