<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:test:complexcontent"
           targetNamespace="urn:test:complexcontent"
           elementFormDefault="qualified">
  <xs:complexType name="BaseType">
    <xs:sequence>
      <xs:element name="BaseField" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="MidType">
    <xs:complexContent>
      <xs:extension base="BaseType">
        <xs:sequence>
          <xs:element name="MidField" type="xs:string"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ExtendedType">
    <xs:complexContent>
      <xs:extension base="MidType">
        <xs:sequence>
          <xs:element name="ExtraField" type="xs:string"/>
          <xs:element name="Count" type="xs:int"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="Document">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Body" type="ExtendedType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
