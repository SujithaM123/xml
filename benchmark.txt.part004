        if (obj.getEarlstPmtDt() != null) write_DateFormat48Choice(w, "EarlstPmtDt", obj.getEarlstPmtDt());
        if (obj.getRDPRefNb() != null) writeLeaf(w, "RDPRefNb", obj.getRDPRefNb());
