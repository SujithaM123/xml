                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SWM1">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithdrawalByTransferSetUpAfterCutOffDateTransferIntoClientsName</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason code is for adjustment made for a withdrawal by transfer set up after the cut off date made transfer into your clients name.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SJWT">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithdrawalTransferAdjustment</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for DTCC WT related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SBB2">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithdrawalTransferBuyBackWithdrawal</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is that your record date position was adjusted for a w/t buy back withdrawal.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SWTA">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WithholdingTaxAdjustmentInUserDefinedCountry</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for adjustment to allocation to charge (user defined percentage) withholding tax in (user defined) country.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SRAH">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WrittenInquiry</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is in response to your written inquiry.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SJEW">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WriteOffReorganisation</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is for write off reorganisation related adjustment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SPRA">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">WrongRatePrincipal</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Adjustment sub-reason is that the principal previously paid to you was at the wrong rate. This adjustment is to correct that erroneous payment.</xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DTCAdjustmentPaymentType4Code">
        <xs:annotation>
