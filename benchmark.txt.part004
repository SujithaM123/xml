package com.bench.stax;

import com.bench.caco.supl011.*;
import javax.xml.stream.XMLOutputFactory;
import javax.xml.stream.XMLStreamException;
import javax.xml.stream.XMLStreamWriter;
import java.io.ByteArrayOutputStream;

/** Hand-written-style StAX writer for CacoSupl011 (generated once from the xjc POJOs; no reflection or JAXB marshalling at runtime). */
public final class CacoSupl011StaxWriter {

    private static final XMLOutputFactory OUTPUT_FACTORY = XMLOutputFactory.newFactory();

    private CacoSupl011StaxWriter() {
    }

    public static byte[] write(Document doc) throws XMLStreamException {
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        XMLStreamWriter w = OUTPUT_FACTORY.createXMLStreamWriter(out, "UTF-8");
        w.writeStartDocument("UTF-8", "1.0");
        write_Document(w, "Document", doc);
        w.writeEndDocument();
        w.flush();
        w.close();
        return out.toByteArray();
    }

    private static void write_Document(XMLStreamWriter w, String tag, Document obj) throws XMLStreamException {
        w.writeStartElement(tag);
        w.writeDefaultNamespace("urn:iso:std:iso:20022:tech:xsd:supl.011.001.11");
        if (obj.getDTCCCACOSD1() != null) write_DTCCCACOSD1V11(w, "DTCCCACOSD1", obj.getDTCCCACOSD1());
        w.writeEndElement();
    }

    private static void write_DTCCCACOSD1V11(XMLStreamWriter w, String tag, DTCCCACOSD1V11 obj) throws XMLStreamException {
        w.writeStartElement(tag);
        if (obj.getCorpActnGnlInf() != null) write_CorporateActionGeneralInformationSD60(w, "CorpActnGnlInf", obj.getCorpActnGnlInf());
        if (obj.getUndrlygScty() != null) write_FinancialInstrumentAttributesSD21(w, "UndrlygScty", obj.getUndrlygScty());
        if (obj.getCorpActnDtls() != null) write_CorporateActionSD20(w, "CorpActnDtls", obj.getCorpActnDtls());
        for (AccountBalanceSD14 item : obj.getAcctBal()) write_AccountBalanceSD14(w, "AcctBal", item);
        if (obj.getCorpActnConfDtls() != null) write_CorporateActionConfirmationDetailsSD2(w, "CorpActnConfDtls", obj.getCorpActnConfDtls());
        for (CorporateActionConfirmationSecuritiesMovementDetailsSD6 item : obj.getCorpActnConfSctiesMvmntDtls()) write_CorporateActionConfirmationSecuritiesMovementDetailsSD6(w, "CorpActnConfSctiesMvmntDtls", item);
        for (CorporateActionConfirmationCashMovementDetailsSD5 item : obj.getCorpActnConfCshMvmntDtls()) write_CorporateActionConfirmationCashMovementDetailsSD5(w, "CorpActnConfCshMvmntDtls", item);
        for (OptionTransactionSD6 item : obj.getOptnTxDtls()) write_OptionTransactionSD6(w, "OptnTxDtls", item);
        w.writeEndElement();
    }

    private static void write_CorporateActionGeneralInformationSD60(XMLStreamWriter w, String tag, CorporateActionGeneralInformationSD60 obj) throws XMLStreamException {
        w.writeStartElement(tag);
        if (obj.getPlcAndNm() != null) writeLeaf(w, "PlcAndNm", obj.getPlcAndNm());
        if (obj.getEvtGrp() != null) writeLeaf(w, "EvtGrp", obj.getEvtGrp().value());
        if (obj.getEvtTp() != null) writeLeaf(w, "EvtTp", obj.getEvtTp().value());
