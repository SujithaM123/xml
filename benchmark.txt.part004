        if (obj.getSubRsnCd() != null) writeLeaf(w, "SubRsnCd", obj.getSubRsnCd().value());
        if (obj.getContraPtcptNb() != null) writeLeaf(w, "ContraPtcptNb", obj.getContraPtcptNb());
        if (obj.getEarlstPmtDt() != null) write_DateFormat48Choice(w, "EarlstPmtDt", obj.getEarlstPmtDt());
