    <xs:simpleType name="Percentage14Rate">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">Percentage14Rate</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Rate expressed as a percentage, that is, in hundredths, for example, 0.7 is 7/10 of a percent, and 7.0 is 7% with 13 fractional digits maximum and 14 total digits.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:decimal">
            <xs:fractionDigits value="13"/>
            <xs:totalDigits value="14"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="PriceDetails38__1">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">PriceDetails38__1</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Provides information about the prices related to a corporate action option.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
